/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-iNlmPcd3zT0/9JNLDNFUfqlU0bvfP6j3qsjtJA+4yeA=' https://ar-cdn.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://ar-cdn.net; connect-src 'self' https://ar-cdn.net; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/ffmpeg-core/*
  Cache-Control: public, max-age=604800

/ffmpeg-core/ffmpeg-core.wasm.br
  Content-Type: application/wasm
  Content-Encoding: br

/*.webp
  Cache-Control: public, max-age=86400

/og.png
  Cache-Control: public, max-age=31536000, immutable
